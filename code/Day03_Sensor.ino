/* ###########################################################
   ###   1. Pin Definitions                                 ###
   ########################################################### */

const int PHOTORESISTOR_PIN = A0;

/* ###########################################################
   ###   2. Setup Function                                  ###
   ########################################################### */

void setup() {
  Serial.begin(9600);
  pinMode(PHOTORESISTOR_PIN, INPUT);
}

/* ###########################################################
   ###   3. Main Loop                                       ###
   ########################################################### */

void loop() {
  int sensorValue = analogRead(PHOTORESISTOR_PIN);
  Serial.println(sensorValue);
  delay(100);
}

